---
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "../styles/tokens.css";
import "../styles/global.css";
import displayFont from "@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url";

import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { BING_SITE_VERIFICATION, BRAND, GA_MEASUREMENT_ID, EMAIL, FOUNDER_NAME, LEGAL_NAME, SITE_URL, SOCIAL_LINKEDIN_FOUNDER, SOCIAL_X } from "../config";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Share image path in /public (1200×630). Defaults to the site-wide /og.png. */
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  noindex = false,
  image = "/og.png",
  imageAlt = "Azoth & Co. — Operations, rebuilt.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL(image, SITE_URL).href;
const isHome = Astro.url.pathname === "/";

const organization = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: BRAND,
  url: SITE_URL,
  email: EMAIL,
  legalName: LEGAL_NAME,
  alternateName: ["Azoth and Co", "Azoth & Co Consulting", "Azoth and Company"],
  description:
    "AI and operations consulting in Dallas–Fort Worth. We turn manual processes into systems your people actually use — diagnosed, built, and kept running, end to end.",
  slogan: "Operations, rebuilt.",
  knowsAbout: [
    "AI consulting",
    "Operations consulting",
    "Workflow automation",
    "AI agents for business",
    "Business process mapping",
    "Reporting automation",
    "Document processing",
    "Local search visibility",
  ],
  areaServed: [
    { "@type": "AdministrativeArea", name: "Dallas–Fort Worth metroplex" },
    ...["Dallas", "Fort Worth", "Plano", "Frisco", "McKinney", "Denton", "Prosper", "Arlington"].map((name) => ({
      "@type": "City",
      name: `${name}, TX`,
    })),
    { "@type": "Country", name: "United States" },
  ],
  address: { "@type": "PostalAddress", addressLocality: "Dallas", addressRegion: "TX", addressCountry: "US" },
  founder: { "@type": "Person", name: FOUNDER_NAME, sameAs: [SOCIAL_LINKEDIN_FOUNDER, SOCIAL_X] },
  sameAs: [SOCIAL_X],
  image: ogImage,
  logo: new URL("/apple-touch-icon.png", SITE_URL).href,
};
const organizationJson = JSON.stringify(organization).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#000000" />
    {BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={BING_SITE_VERIFICATION} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    {isHome && <script is:inline type="application/ld+json" set:html={organizationJson} />}
    <slot name="head" />

    {
      GA_MEASUREMENT_ID && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`} />
          <script is:inline define:vars={{ id: GA_MEASUREMENT_ID }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              dataLayer.push(arguments);
            };
            gtag("js", new Date());
            gtag("config", id);
            // Named events for the actions that matter. Mark book_call and begin_checkout as key events in GA4.
            document.addEventListener("click", (e) => {
              const a = e.target.closest && e.target.closest("a[href]");
              if (!a) return;
              const href = a.href;
              const where = { link_url: href, page_path: location.pathname };
              if (href.includes("cal.com/azothandco")) gtag("event", "book_call", { ...where, link_text: a.textContent.trim().slice(0, 80) });
              else if (href.includes("buy.stripe.com")) gtag("event", "begin_checkout", { ...where, link_text: a.textContent.trim().slice(0, 80) });
              else if (href.startsWith("mailto:")) gtag("event", "contact_email", where);
            });
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      (() => {
        const items = document.querySelectorAll("[data-reveal]");
        const show = (el) => el.classList.add("is-in");
        if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) {
          items.forEach(show);
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              show(entry.target);
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
        );
        items.forEach((el) => observer.observe(el));
      })();
    </script>
  </body>
</html>
