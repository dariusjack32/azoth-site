---
import Button from "./Button.astro";

const path = Astro.url.pathname;
const links = [
  { href: "/services/", label: "Services" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];
const current = (href: string) => (path.startsWith(href) ? "page" : undefined);
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="/" aria-label="Azoth & Co., home">
      <span aria-hidden="true">AZOTH <span class="wordmark__amp">&amp;</span> CO.</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__links" role="list">
        {
          links.map((link) => (
            <li>
              <a class="site-nav__link" href={link.href} aria-current={current(link.href)}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <span class="site-nav__divider" aria-hidden="true"></span>
      <a class="site-nav__login" href="/portal/" aria-current={current("/portal/")}>Client login</a>
      <Button href="/contact/" size="sm" class="site-nav__cta">Book a call</Button>
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle>Menu</button
    >
  </div>

  <div class="site-menu" id="site-menu" hidden>
    <div class="wrap site-menu__inner">
      <ul class="site-menu__links" role="list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={current(link.href)}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="site-menu__login" href="/portal/" aria-current={current("/portal/")}>Client login</a>
      <Button href="/contact/" class="site-menu__cta">Book a call</Button>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.querySelector("[data-menu-toggle]");
    const menu = document.getElementById("site-menu");
    if (!toggle || !menu) return;
    const behind = () => [document.getElementById("main"), document.querySelector(".site-footer")];
    const setOpen = (open) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.textContent = open ? "Close" : "Menu";
      menu.hidden = !open;
      document.documentElement.classList.toggle("menu-open", open);
      behind().forEach((el) => el && (el.inert = open));
    };
    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    menu.addEventListener("click", (event) => {
      if (event.target.closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
    matchMedia("(min-width: 62.5em)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  })();
</script>

<style>
  .site-header {
    position: relative;
    z-index: 50;
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    min-height: var(--header-h);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.3em;
    white-space: nowrap;
  }

  .wordmark__amp {
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.12em;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.75rem;
  }

  .site-nav__links {
    display: flex;
    gap: 1.75rem;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    letter-spacing: 0.01em;
    transition: color 0.2s var(--ease);
  }

  .site-nav__link:hover {
    color: var(--gold);
  }

  .site-nav__link[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.55em;
  }

  .site-nav__divider {
    width: 1px;
    height: 1.25rem;
    background: var(--rule);
  }

  .site-nav__login,
  .site-menu__login {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ash);
    font-family: var(--font-mono);
    font-size: var(--label-size);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 0.2s var(--ease);
  }

  .site-nav__login:hover,
  .site-nav__login[aria-current="page"],
  .site-menu__login:hover,
  .site-menu__login[aria-current="page"] {
    color: var(--bone);
  }

  .menu-toggle {
    display: none;
    min-height: 2.75rem;
    padding: 0 0 0 1rem;
    border: 0;
    background: none;
    color: var(--bone);
    font-family: var(--font-mono);
    font-size: var(--label-size);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .site-menu {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow-y: auto;
    padding-top: calc(var(--header-h) + 1.5rem);
    padding-bottom: 3rem;
    background: var(--obsidian);
  }

  .site-menu[hidden] {
    display: none;
  }

  .site-menu__links {
    border-top: 1px solid var(--rule);
  }

  .site-menu__links a {
    display: block;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--rule-faint);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 8vw, 3.25rem);
    font-weight: 300;
    line-height: 1.1;
  }

  .site-menu__links a[aria-current="page"] {
    color: var(--gold);
  }

  .site-menu__login {
    margin-top: 1.75rem;
  }

  .site-menu__inner :global(.site-menu__cta) {
    display: flex;
    width: 100%;
    margin-top: 1.75rem;
  }

  @media (max-width: 62.4375em) {
    .site-nav__divider,
    .site-nav :global(.site-nav__cta) {
      display: none;
    }

    :global(.js) .site-nav {
      display: none;
    }

    :global(.js) .menu-toggle {
      display: inline-flex;
      align-items: center;
    }
  }

  :global(html.menu-open) {
    overflow: hidden;
  }
</style>
