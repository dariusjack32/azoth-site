---
import Mark from "./Mark.astro";
import { EMAIL, LEGAL_NAME, LOCATION } from "../config";

const year = new Date().getFullYear();
const links = [
  { href: "/services/", label: "Services" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
  { href: "/portal/", label: "Client login" },
  { href: "/privacy/", label: "Privacy" },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__inner grid">
      <div class="site-footer__brand">
        <Mark size={44} />
        <p class="site-footer__wordmark" aria-hidden="true">AZOTH <span class="amp">&amp;</span> CO.</p>
        <p class="site-footer__desc muted">
          AI &amp; Operations Consulting · <span class="nowrap">{LOCATION}</span>
        </p>
      </div>

      <nav class="site-footer__nav" aria-label="Footer">
        <ul role="list">
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-footer__contact">
        <a class="text-link" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </div>

      <div class="site-footer__base">
        <p class="label">© {year} {LEGAL_NAME}</p>
        <p class="label site-footer__motto" lang="la" title="Dissolve and coagulate — take it apart, rebuild it right.">
          Solve et coagula
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer__inner {
    row-gap: 3rem;
    padding-block: clamp(4rem, 8vw, 6.5rem) 2.5rem;
    border-top: 1px solid var(--rule);
  }

  .site-footer__brand,
  .site-footer__nav,
  .site-footer__contact,
  .site-footer__base {
    grid-column: 1 / -1;
  }

  .site-footer__wordmark {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.3em;
  }

  .amp {
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.12em;
  }

  .site-footer__desc {
    margin-top: 0.9rem;
    font-size: 0.9375rem;
  }

  .site-footer__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    font-size: 0.9375rem;
    transition: color 0.2s var(--ease);
  }

  .site-footer__nav a:hover {
    color: var(--gold);
  }

  .site-footer__contact {
    font-size: 0.9375rem;
  }

  .site-footer__contact .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule-faint);
  }

  .site-footer__motto {
    cursor: help;
  }

  @media (min-width: 48em) {
    .site-footer__brand {
      grid-column: 1 / span 6;
    }

    .site-footer__nav {
      grid-column: 7 / span 3;
    }

    .site-footer__contact {
      grid-column: 10 / -1;
    }
  }
</style>
