---
/**
 * Long-form page under /visibility/: header, prose body, next steps, related reading.
 * Emits Article + BreadcrumbList (+ FAQPage when faqs are passed) structured data.
 */
import Base from "../layouts/Base.astro";
import PageHeader from "./PageHeader.astro";
import Section from "./Section.astro";
import Button from "./Button.astro";
import ClosingCTA from "./ClosingCTA.astro";
import { BRAND, CAL_LINK, FOUNDER_NAME, SITE_URL, SOCIAL_LINKEDIN_FOUNDER } from "../config";
import { GUIDES } from "../data/guides";

interface Props {
  title: string;
  description: string;
  label: string;
  heading: string;
  sub: string;
  /** ISO date, e.g. "2026-11-11". */
  published: string;
  faqs?: { q: string; a: string }[];
}

const { title, description, label, heading, sub, published, faqs = [] } = Astro.props;
const path = Astro.url.pathname;
const url = new URL(path, SITE_URL).href;
const related = GUIDES.filter((g) => g.href !== path);

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: heading,
    description,
    url,
    datePublished: published,
    dateModified: published,
    author: { "@type": "Person", name: FOUNDER_NAME, sameAs: [SOCIAL_LINKEDIN_FOUNDER] },
    publisher: { "@type": "Organization", name: BRAND, url: SITE_URL },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Visibility", item: `${SITE_URL}/visibility/` },
      { "@type": "ListItem", position: 3, name: label, item: url },
    ],
  },
  ...(faqs.length
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: faqs.map((f) => ({
            "@type": "Question",
            name: f.q,
            acceptedAnswer: { "@type": "Answer", text: f.a },
          })),
        },
      ]
    : []),
]).replace(/</g, "\\u003c");
---

<Base title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={schema} slot="head" />

  <PageHeader label={`Visibility · ${label}`} title={heading} sub={sub}>
    <p class="guide__byline label">By {FOUNDER_NAME}, {BRAND} · Dallas–Fort Worth</p>
  </PageHeader>

  <Section>
    <article class="prose">
      <slot />
    </article>
  </Section>

  <Section label="Next step">
    <div class="guide__next">
      <p class="lede">
        Check yourself in ten minutes with the free <a class="text-link" href="/visibility/scorecard/">Visibility Scorecard</a>.
        Or have us do it properly: the <a class="text-link" href="/visibility/#audit">Visibility Audit</a> is $2,500, fixed,
        and ends in a ranked fix list.
      </p>
      <div class="guide__actions">
        <Button href={CAL_LINK}>Book a 15-minute call</Button>
        <a class="link" href="/visibility/">See the Visibility track</a>
      </div>
    </div>
  </Section>

  {
    faqs.length > 0 && (
      <Section id="questions" label="Questions" labelAs="h2">
        <div class="faq">
          {faqs.map((item) => (
            <details class="faq__item">
              <summary class="faq__q">
                <span class="faq__question">{item.q}</span>
                <span class="faq__icon" aria-hidden="true" />
              </summary>
              <div class="faq__a">
                <p class="muted">{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </Section>
    )
  }

  <Section label="Read next">
    <ul class="guide__related" role="list">
      {
        related.map((g) => (
          <li>
            <a class="guide__link" href={g.href}>
              <span class="h-item">{g.title}</span>
              <span class="muted">{g.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <ClosingCTA />
</Base>

<style>
  .guide__byline {
    margin-top: 1.5rem;
  }

  .guide__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 2rem;
  }

  .guide__related {
    border-top: 1px solid var(--rule);
  }

  .guide__link {
    display: grid;
    gap: 0.4rem;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--rule-faint);
    color: inherit;
    text-decoration: none;
  }

  .guide__link:hover .h-item,
  .guide__link:focus-visible .h-item {
    color: var(--gold);
  }
</style>
