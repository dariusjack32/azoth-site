---
/**
 * The Azoth & Co. mark: a thin circle enclosing an upward equilateral triangle,
 * barred across its lower third. It reads as an "A"; it is also the classical
 * alchemical sign for air. Strokes stay 1.25px at any size (non-scaling).
 */
interface Props {
  size?: number | string;
  /** Stroke width in screen pixels. */
  weight?: number;
  /** Give the mark an accessible name; omit when it's decorative. */
  title?: string;
  class?: string;
  [key: string]: unknown;
}

const { size = 48, weight = 1.25, title, class: className, ...rest } = Astro.props;
---

<svg
  class:list={["mark", className]}
  viewBox="0 0 100 100"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  style={`--mark-weight: ${weight}px`}
  role={title ? "img" : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : "true"}
  {...rest}
>
  <circle cx="50" cy="50" r="46"></circle>
  <path d="M50 4 L89.837 73 L10.163 73 Z"></path>
  <path d="M23.442 50 H76.558"></path>
</svg>

<style>
  .mark {
    flex: none;
    color: var(--gold);
  }

  .mark circle,
  .mark path {
    stroke-width: var(--mark-weight, 1.25px);
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
  }
</style>
