---
import Mark from "./Mark.astro";
import Button from "./Button.astro";
import { CAL_LINK, CAL_LINK_DISCOVERY, EMAIL } from "../config";
---

<section class="cta" aria-labelledby="cta-title">
  <div class="wrap">
    <div class="cta__inner grid">
      <div class="cta__margin">
        <Mark size={56} />
      </div>
      <div class="cta__body">
        <h2 id="cta-title" class="h-section" data-reveal>Find the one fix that pays for the rest.</h2>
        <p class="cta__text lede muted" data-reveal style="--i: 1">
          A conversation, not a pitch. Assistants are welcome to schedule on your behalf.
        </p>
        <div class="cta__action" data-reveal style="--i: 2">
          <Button href={CAL_LINK}>Book a conversation</Button>
          <a class="link" href={CAL_LINK_DISCOVERY}>Have a specific process in mind? Book a discovery session</a>
        </div>
        <p class="cta__email muted" data-reveal style="--i: 3">
          Or write to <a class="text-link" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .cta__inner {
    row-gap: 2.5rem;
    padding-block: var(--section-y);
    border-top: 1px solid var(--rule);
  }

  .cta__margin,
  .cta__body {
    grid-column: 1 / -1;
  }

  .cta__text {
    margin-top: 1.75rem;
  }

  .cta__action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 2.75rem;
  }

  .cta__email {
    margin-top: 1.75rem;
    font-size: 0.9375rem;
  }

  @media (min-width: 64em) {
    .cta__margin {
      grid-column: 1 / span 3;
      padding-top: 0.6rem;
    }

    .cta__body {
      grid-column: 4 / -1;
    }
  }
</style>
