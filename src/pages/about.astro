---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/Section.astro";
import Mark from "../components/Mark.astro";
import ClosingCTA from "../components/ClosingCTA.astro";
import { FOUNDER_NAME, FOUNDER_PHOTO } from "../config";
---

<Base
  title="About — Azoth & Co."
  description="Azoth & Co. is an AI and operations consultancy in Dallas–Fort Worth. We start with the work, not the technology."
>
  <PageHeader label="About" title="An old idea, applied to modern work." />

  <Section id="name" label="The name">
    <p class="statement" data-reveal>
      In alchemy, Azoth was the name for the universal solvent — the agent of transformation itself.
    </p>
    <div class="about__copy" data-reveal>
      <p class="lede">
        Later esoteric writers read the word as the first and last letters of three ancient alphabets: A and Z, Alpha
        and Omega, Aleph and Tav. The beginning and the end.
      </p>
      <p class="lede muted">
        We took the name for both meanings. We transform how work gets done, and we own it from beginning to end.
      </p>
    </div>
  </Section>

  <Section id="approach" label="The approach">
    <p class="statement" data-reveal>
      Most firms don’t need more software. They need the software they already have to work together — and to work
      the way their people do.
    </p>
    <p class="about__copy lede muted" data-reveal>
      So we start with the work, not the technology: understand it, then build the system around it.
    </p>
  </Section>

  <Section id="founder" label="Founder">
    <div class="founder">
      <div class="founder__portrait">
        {
          FOUNDER_PHOTO ? (
            <img src={FOUNDER_PHOTO} alt={`Portrait of ${FOUNDER_NAME}`} width="640" height="800" loading="lazy" decoding="async" />
          ) : (
            <Mark size="38%" />
          )
        }
      </div>
      <div class="founder__text" data-reveal>
        <p class="lede">Azoth &amp; Co. was founded by {FOUNDER_NAME} in Dallas–Fort Worth.</p>
        <figure class="founder__quote">
          <blockquote>
            <p>
              I started Azoth &amp; Co. because I kept seeing the same thing: capable people buried in work a system
              should be doing. My background is in psychology and high-volume sales — understanding what people
              actually need, and what they’ll actually use. Azoth &amp; Co. puts that to work on how firms operate.
            </p>
          </blockquote>
          <figcaption>
            <span class="founder__name">{FOUNDER_NAME}</span>
            <span class="label">Founder</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </Section>

  <ClosingCTA />
</Base>

<style>
  .about__copy {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 64em) {
    .about__copy {
      grid-column: 4 / -1;
    }
  }

  .founder {
    display: grid;
    gap: 2.5rem;
  }

  .founder__portrait {
    display: grid;
    place-items: center;
    width: min(100%, 22rem);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--ink);
  }

  .founder__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
  }

  .founder__quote {
    margin-top: 2.25rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--rule-faint);
  }

  .founder__quote blockquote p {
    max-width: 34ch;
    font-family: var(--font-display);
    font-size: var(--statement);
    font-style: italic;
    line-height: 1.3;
    text-wrap: pretty;
  }

  .founder__quote figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    margin-top: 1.75rem;
  }

  .founder__name {
    font-size: 0.9375rem;
  }

  @media (min-width: 64em) {
    .founder {
      grid-template-columns: subgrid;
      align-items: start;
    }

    .founder__portrait {
      grid-column: 1 / span 3;
      width: 100%;
    }

    .founder__text {
      grid-column: 5 / -1;
    }
  }
</style>
