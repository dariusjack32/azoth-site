---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/Button.astro";
import {
  EMAIL,
  STRIPE_LINK_AUDIT,
  STRIPE_LINK_MAP_LIGHT,
  STRIPE_LINK_MAP_FULL,
  STRIPE_LINK_RETAINER_ESSENTIALS,
  STRIPE_LINK_RETAINER_GROWTH,
} from "../../config";

type Row = { name: string; price: string; note: string; href: string };

const groups: { label: string; rows: Row[] }[] = [
  {
    label: "Diagnose",
    rows: [
      {
        name: "Visibility Audit",
        price: "$2,500",
        note: "Written audit with the fix list and 90-day targets. Credited toward a Build started within 30 days.",
        href: STRIPE_LINK_AUDIT,
      },
      {
        name: "Map, Light",
        price: "$6,500",
        note: "One team or function. Credited toward a Build started within 60 days.",
        href: STRIPE_LINK_MAP_LIGHT,
      },
      {
        name: "Map, Full",
        price: "$18,000",
        note: "The whole operation. Credited toward a Build started within 60 days.",
        href: STRIPE_LINK_MAP_FULL,
      },
    ],
  },
  {
    label: "Steward",
    rows: [
      {
        name: "Visibility Retainer, Essentials",
        price: "$750 / month",
        note: "Monitoring, reviews, listings, rank tracking, monthly report. Month to month after three.",
        href: STRIPE_LINK_RETAINER_ESSENTIALS,
      },
      {
        name: "Visibility Retainer, Growth",
        price: "$1,500 / month",
        note: "Essentials plus a new page a month, content repurposing, seasonal offers.",
        href: STRIPE_LINK_RETAINER_GROWTH,
      },
    ],
  },
];
const anyLinked = groups.some((g) => g.rows.some((r) => r.href));
---

<Base
  title="Pay — Azoth & Co."
  description="Pay for an Azoth & Co. engagement. Card or US bank account, through Stripe. Builds are invoiced."
  noindex
>
  <PageHeader label="Payments" title="Pay for an engagement." compact>
    <p class="lede pay__lede">
      Card or US bank account, through Stripe. You will get a receipt and an invoice by email.
    </p>
    <p class="muted">
      Builds, Map Extended and anything custom are invoiced: pay from the link in the invoice email. Questions:
      <a class="text-link" href={`mailto:${EMAIL}`}>{EMAIL}</a>.
    </p>
  </PageHeader>

  {
    groups.map((group) => (
      <Section label={group.label} labelAs="h2" class="pay-group">
        <ul class="pay" role="list">
          {group.rows.map((row) => (
            <li class="pay__row">
              <div class="pay__main">
                <h3 class="h-item">{row.name}</h3>
                <p class="pay__note muted">{row.note}</p>
              </div>
              <p class="pay__price">{row.price}</p>
              <div class="pay__action">
                {row.href ? (
                  <Button href={row.href} size="sm" rel="noopener">
                    Pay
                  </Button>
                ) : (
                  <span class="label pay__invoiced">By invoice</span>
                )}
              </div>
            </li>
          ))}
        </ul>
      </Section>
    ))
  }

  {
    !anyLinked && (
      <Section>
        <p class="muted">Online payment is being set up. Until then every engagement is invoiced by email.</p>
      </Section>
    )
  }
</Base>

<style>
  .pay__lede {
    max-width: 40ch;
  }

  :global(.pay-group .section__inner) {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .pay {
    border-top: 1px solid var(--rule);
  }

  .pay__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem 2rem;
    align-items: start;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule-faint);
  }

  .pay__note {
    margin-top: 0.5rem;
    max-width: 44ch;
    font-size: 0.9375rem;
  }

  .pay__price {
    font-family: var(--font-display);
    font-size: 1.25rem;
    white-space: nowrap;
  }

  .pay__action {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
  }

  .pay__invoiced {
    color: var(--muted, inherit);
  }

  @media (min-width: 48em) {
    .pay__row {
      grid-template-columns: 1fr auto auto;
      align-items: center;
    }
  }
</style>
