---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import SectionLabel from "../components/SectionLabel.astro";
import Button from "../components/Button.astro";
import HeroArt from "../components/HeroArt.astro";
import ArrowDown from "../components/ArrowDown.astro";
import ClosingCTA from "../components/ClosingCTA.astro";
import { audiences, capabilities, principles, stages } from "../data/copy";
---

<Base
  title="Azoth & Co. — Operations, rebuilt."
  description="AI and operations consulting. We turn manual processes into systems your people actually use — diagnosed, built, and kept running, end to end."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div class="hero__grid">
        <div class="hero__copy">
          <SectionLabel>AI &amp; Operations Consulting</SectionLabel>
          <h1 id="hero-title" class="hero__title">
            <span class="hero__line">Operations,</span>
            <span class="hero__line hero__line--indent">rebuilt.</span>
          </h1>
          <p class="hero__sub">
            Azoth &amp; Co. turns manual processes into <span class="nowrap">AI-powered</span> systems your people actually
            use — diagnosed, built, and kept running, end to end.
          </p>
          <div class="hero__actions">
            <Button href="/contact/">Book a call</Button>
            <a class="link" href="#how">How we work <ArrowDown /></a>
          </div>
        </div>
        <HeroArt class="hero__art" />
      </div>
    </div>
  </section>

  <Section id="problem" label="The cost of manual">
    <h2 class="h-section" data-reveal>Your most expensive people are doing your cheapest work.</h2>
    <ul class="symptoms" role="list">
      <li data-reveal style="--i: 0">Re-keying data between systems.</li>
      <li data-reveal style="--i: 1">Chasing updates over email.</li>
      <li data-reveal style="--i: 2">Rebuilding the same report every month.</li>
      <li data-reveal style="--i: 3">Knowledge that lives in one person’s head.</li>
    </ul>
    <p class="problem__close lede" data-reveal>
      None of it shows up as a line item — it’s paid for in late nights, avoidable errors, and decisions made on stale
      numbers.
    </p>
  </Section>

  <Section id="how" label="How we work">
    <h2 class="h-section" data-reveal>Diagnose. Build. Keep it running.</h2>
    <ol class="stages" role="list">
      {
        stages.map((stage, i) => (
          <li class="stage" data-reveal style={`--i: ${i}`}>
            <p class="stage__numeral" aria-hidden="true">
              {stage.numeral}
            </p>
            <h3 class="stage__name h-item">{stage.name}</h3>
            <p class="stage__descriptor label">{stage.descriptor}</p>
            <p class="stage__text muted">{stage.summary}</p>
          </li>
        ))
      }
    </ol>
    <p class="how__more">
      <a class="link" href="/services/">See each stage in detail</a>
    </p>
  </Section>

  <Section id="build" label="What we build">
    <h2 class="h-section" data-reveal>Systems, not slide decks.</h2>
    <ol class="ledger" role="list">
      {
        capabilities.map((item) => (
          <li class="ledger__row" data-reveal>
            <span class="ledger__n label" aria-hidden="true">
              {item.n}
            </span>
            <h3 class="ledger__title h-item">{item.title}</h3>
            <p class="ledger__text muted">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="who" label="Who we work with">
    <h2 class="h-section" data-reveal>Firms where time is expensive.</h2>
    <ul class="audiences" role="list">
      {
        audiences.map((audience, i) => (
          <li class="audience" data-reveal style={`--i: ${i}`}>
            <h3 class="h-item">{audience.title}</h3>
            <p class="audience__text muted">{audience.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="principles" label="Principles" labelAs="h2">
    <ul class="principles" role="list">
      {
        principles.map((principle, i) => (
          <li class="principle" data-reveal style={`--i: ${i % 2}`}>
            <h3 class="h-item">{principle.title}</h3>
            <p class="principle__text muted">{principle.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <ClosingCTA />
</Base>

<style>
  /* Hero */
  .hero {
    padding-block: clamp(1.5rem, 5vw, 3rem) clamp(3.5rem, 7vw, 6rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    align-items: center;
  }

  .hero__copy {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .hero__art {
    grid-column: 1 / -1;
    grid-row: 1;
    width: min(66vw, 20rem);
    margin-bottom: clamp(2rem, 7vw, 3.5rem);
  }

  .hero__title {
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-size: var(--step-hero);
    font-weight: 300;
    line-height: 0.94;
    letter-spacing: -0.022em;
  }

  .hero__line {
    display: block;
  }

  .hero__line--indent {
    padding-left: 0.9em;
  }

  .hero__sub {
    max-width: 33rem;
    margin-top: clamp(2rem, 4vw, 2.75rem);
    font-size: var(--step-1);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2.25rem;
    margin-top: clamp(2.25rem, 4vw, 3rem);
  }

  @media (min-width: 64em) {
    .hero__grid {
      min-height: min(calc(100svh - var(--header-h) - 3rem), 56rem);
    }

    .hero__copy {
      grid-column: 1 / span 7;
      grid-row: 1;
    }

    .hero__art {
      grid-column: 8 / -1;
      grid-row: 1;
      justify-self: end;
      width: 100%;
      max-width: 36rem;
      margin: 0;
    }
  }

  /* The cost of manual */
  .symptoms {
    border-top: 1px solid var(--rule-faint);
  }

  .symptoms li {
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--rule-faint);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.15;
  }

  @media (min-width: 48em) {
    .symptoms {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--col-gap);
      border-top: 0;
    }

    .symptoms li:nth-child(-n + 2) {
      border-top: 1px solid var(--rule-faint);
    }
  }

  /* On desktop the 2×2 snaps to the page grid, and the closing line hangs from its second column. */
  @media (min-width: 64em) {
    .symptoms {
      grid-template-columns: subgrid;
    }

    .symptoms li:nth-child(odd) {
      grid-column: 1 / span 4;
    }

    .symptoms li:nth-child(even) {
      grid-column: 5 / -1;
    }

    .problem__close {
      grid-column: 5 / -1;
    }
  }

  /* How we work */
  .stage {
    padding-block: 2rem 2.25rem;
    border-top: 1px solid var(--rule);
  }

  .stage__numeral {
    color: var(--gold);
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 2.6rem + 3vw, 6rem);
    font-weight: 300;
    line-height: 1;
  }

  .stage__name {
    margin-top: 1.5rem;
  }

  .stage__descriptor {
    margin-top: 0.55rem;
  }

  .stage__text {
    max-width: 36ch;
    margin-top: 1.5rem;
  }

  @media (min-width: 56em) {
    .stages {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--col-gap);
    }

    .stage {
      padding-block: 0.25rem 0;
      padding-left: clamp(1.25rem, 2.2vw, 2.25rem);
      border-top: 0;
      border-left: 1px solid var(--rule);
    }

    .stage:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (min-width: 64em) {
    .stages {
      grid-template-columns: subgrid;
    }

    .stage {
      grid-column: span 3;
    }
  }

  /* What we build */
  .ledger {
    border-top: 1px solid var(--rule);
  }

  .ledger__row {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    column-gap: 1rem;
    row-gap: 0.7rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--rule-faint);
  }

  .ledger__n {
    padding-top: 0.6em;
    color: var(--gold);
  }

  .ledger__title,
  .ledger__text {
    grid-column: 2;
  }

  .ledger__text {
    max-width: 46ch;
  }

  @media (min-width: 64em) {
    .ledger {
      display: grid;
      grid-template-columns: subgrid;
    }

    .ledger__row {
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      align-items: baseline;
      padding-block: 2.25rem;
    }

    .ledger__n {
      grid-column: 1;
      padding-top: 0;
    }

    .ledger__title {
      grid-column: 2 / span 4;
    }

    .ledger__text {
      grid-column: 6 / -1;
    }
  }

  /* Who we work with */
  .audience {
    padding-block: 1.75rem 2rem;
    border-top: 1px solid var(--rule-faint);
  }

  .audience__text {
    max-width: 30ch;
    margin-top: 0.9rem;
  }

  @media (min-width: 56em) {
    .audiences {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--col-gap);
    }
  }

  @media (min-width: 64em) {
    .audiences {
      grid-template-columns: subgrid;
    }

    .audience {
      grid-column: span 3;
    }
  }

  /* Principles — a 2×2, quartered by hairlines */
  .principle {
    padding-block: 2rem;
    border-top: 1px solid var(--rule-faint);
  }

  .principle:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .principle__text {
    max-width: 38ch;
    margin-top: 1rem;
  }

  @media (min-width: 48em) {
    .principles {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .principle {
      padding: clamp(2rem, 4vw, 3.25rem);
      border-top: 0;
    }

    .principle:nth-child(odd) {
      padding-left: 0;
      border-right: 1px solid var(--rule);
    }

    .principle:nth-child(even) {
      padding-right: 0;
    }

    .principle:nth-child(-n + 2) {
      padding-top: 0;
      border-bottom: 1px solid var(--rule);
    }

    .principle:nth-child(n + 3) {
      padding-bottom: 0;
    }
  }
</style>
